# Copy this file to ".env" (same folder) and fill in your keys. Never share or upload the .env file.

# Required for writing scripts (https://console.anthropic.com). Set a spending limit there.
ANTHROPIC_API_KEY=

# Optional: stock photos (free keys)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: headline APIs
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# Optional: paid voices (edge-tts, kokoro and piper need no key)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Optional: Google Programmable Search for person photos (licence unknown; always needs your approval)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Voice cloning (own_voice): set this to 1 to accept Coqui's non-commercial XTTS licence
# on the first model download. Personal use only.
COQUI_TOS_AGREED=
